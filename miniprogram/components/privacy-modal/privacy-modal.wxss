.privacy-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.privacy-dialog {
  width: 600rpx;
  padding: 48rpx 40rpx 32rpx;
  border-radius: 24rpx;
  background: #fffaf7;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #4e342e;
  text-align: center;
  margin-bottom: 28rpx;
}

.privacy-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: #6b5b55;
  margin-bottom: 40rpx;
}

.privacy-link {
  color: #52C41A;
}

.privacy-btns {
  display: flex;
  gap: 20rpx;
}

.privacy-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.reject {
  background: #f2ece9;
  color: #7a6b65;
}

.privacy-btn.agree {
  background: #95DE64;
  color: #ffffff;
}
