.page {
  padding-bottom: 160rpx;
}

.baby-tip {
  margin: 24rpx;
  background: #fff3e0;
  color: #fb8c00;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}
.baby-tip.ok {
  background: #e8f5e9;
  color: #43a047;
}
.baby-tip.warn-solid {
  background: #e3f2fd;
  color: #1e88e5;
}

.form-label {
  font-size: 28rpx;
  color: #666;
}
.form-picker {
  font-size: 30rpx;
  margin-top: 16rpx;
}
.form-picker.placeholder {
  color: #bbb;
}

/* 食谱选择字段 */
.recipe-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  margin-top: 16rpx;
  min-height: 72rpx;
  background: #f7f3f0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.recipe-field.placeholder {
  color: #bbb;
}
.recipe-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  color: #b0a49c;
  font-size: 34rpx;
  margin-right: -8rpx;
}

/* 食谱选择半屏弹窗 */
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
}
.picker-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 0;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.picker-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: #999;
  font-size: 32rpx;
}
.picker-search {
  background: #f7f3f0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
}
.picker-search-input {
  height: 72rpx;
  font-size: 28rpx;
}
.picker-list {
  max-height: 50vh;
}
.recipe-opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 2rpx solid #f7f3f0;
}
.recipe-opt:last-of-type {
  border-bottom: none;
}
.recipe-opt.active {
  background: #fff0e9;
  border-radius: 12rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
}
.recipe-opt-title {
  font-size: 28rpx;
  color: #333;
}
.recipe-opt.active .recipe-opt-title {
  color: #ff7043;
  font-weight: 600;
}
.recipe-opt-sub {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #b0a49c;
  margin-left: 16rpx;
}
.recipe-empty,
.recipe-more {
  padding: 24rpx;
  font-size: 24rpx;
  color: #b0a49c;
  text-align: center;
}
.recipe-add {
  margin: 0 0 16rpx;
  padding: 18rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ff7043;
  background: #fff0e9;
  border-radius: 16rpx;
  font-weight: 600;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f7f3f0;
}
.form-item:last-child {
  border-bottom: none;
}
.form-item .form-label {
  width: 140rpx;
  flex-shrink: 0;
}
.reaction-group {
  display: flex;
  gap: 20rpx;
}
.reaction-opt {
  padding: 10rpx 40rpx;
  border-radius: 32rpx;
  background: #f7f3f0;
  font-size: 28rpx;
}
.reaction-opt.active {
  background: #e8f5e9;
  color: #43a047;
  font-weight: 600;
}
.reaction-opt.active.reaction-allergy {
  background: #ffebee;
  color: #e53935;
}
.reaction-opt.active.reaction-discomfort {
  background: #fff3e0;
  color: #fb8c00;
}

.note-input {
  width: 100%;
  height: 180rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
}

/* 图片选择区 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.img-item {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  margin: 0 16rpx 16rpx 0;
}
.img-thumb {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}
.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}
.img-add {
  width: 152rpx;
  height: 152rpx;
  border: 2rpx dashed #d8ccc4;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #c9b8ac;
  box-sizing: border-box;
}
.img-add.disabled {
  opacity: 0.35;
}

.save-btn {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 60rpx;
  text-align: center;
  line-height: 88rpx;
  background: linear-gradient(135deg, #ff8a65, #ff7043);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.save-btn.disabled {
  background: #ccc;
  color: #fff;
}
