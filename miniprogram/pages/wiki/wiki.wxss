.page {
  padding-bottom: 40rpx;
}

/* 固定头部：搜索框 + 排序说明，滑动时保持不动 */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #f5f5f5;
  padding: 24rpx 24rpx 16rpx;
}
/* 占位块：高度 = 头部实际高度（24 + 80 + 16 + 排序说明行高 + 16） */
.header-placeholder {
  height: 168rpx;
}

.search-bar {
  position: relative;
}
.search-input {
  background: #fff;
  border-radius: 40rpx;
  height: 80rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.search-clear {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  color: #bbb;
  font-size: 32rpx;
  padding: 20rpx;
}

.sort-tip {
  margin: 16rpx 8rpx 0;
  font-size: 22rpx;
  color: #b0a49c;
}

.ingredient-list {
  margin: 0 24rpx;
}
.ingredient-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.06);
}
.ing-emoji {
  font-size: 56rpx;
  width: 88rpx;
  height: 88rpx;
  background: #E4F3D7;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ing-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.ing-name {
  font-size: 30rpx;
  font-weight: 700;
}
.ing-nutrition {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ing-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
/* 清除全局 .tag 的右边距，保证月龄标签与过敏等级右边缘对齐 */
.ing-right .tag {
  margin-right: 0;
}
/* 过敏等级胶囊：与月龄标签同款胶囊样式，按风险档位配色 */
.ing-risk {
  font-size: 22rpx;
  padding: 4rpx 20rpx;
  border-radius: 24rpx;
  background: #e8f5e9;
  color: #43a047;
}
.ing-risk.risk-mid {
  background: #fff3e0;
  color: #f57c00;
}
.ing-risk.risk-high {
  background: #ffebee;
  color: #e53935;
}

/* 食材详情弹窗：标题居中、内容左对齐 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-card {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.modal-row {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}
.modal-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  background: #52C41A;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}
.modal-btn::after {
  border: none;
}
