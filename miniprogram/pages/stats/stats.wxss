.page {
  padding: 24rpx 24rpx 40rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.06);
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

/* 范围切换 */
.range-chips {
  display: flex;
  margin-bottom: 24rpx;
}
.chip {
  padding: 12rpx 44rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  border: 2rpx solid transparent;
}
.chip.active {
  background: #52C41A;
  color: #fff;
  font-weight: 600;
}

/* 概览三格 */
.overview {
  display: flex;
  padding: 32rpx 0;
}
.ov-cell {
  flex: 1;
  text-align: center;
}
.ov-cell + .ov-cell {
  border-left: 2rpx solid #F0F6E8;
}
.ov-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #52C41A;
}
.ov-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 反应分布条形 */
.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.dist-row:last-child {
  margin-bottom: 0;
}
.dist-label {
  width: 80rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}
.dist-track {
  flex: 1;
  height: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.dist-bar {
  height: 100%;
  border-radius: 12rpx;
}
.dist-count {
  width: 72rpx;
  text-align: right;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}
.dist-none-tip {
  font-size: 26rpx;
  color: #52C41A;
  line-height: 1.6;
}

/* 过敏关注 */
.allergy-tip {
  font-size: 24rpx;
  color: #e53935;
  background: #fff5f5;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* 排行行（过敏关注 / Top5 共用） */
.rank-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F7F7F7;
}
.rank-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.rank-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.rank-no.rank-hot {
  background: #52C41A;
  color: #fff;
}
.rank-emoji {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.rank-title {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-count {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 近 30 天热度：30 根细柱 */
.heat {
  display: flex;
  align-items: flex-end;
  height: 140rpx;
  gap: 4rpx;
}
.heat-col {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
}
.heat-bar {
  width: 100%;
  background: #52C41A;
  border-radius: 4rpx;
}
.heat-bar.heat-zero {
  background: #eee;
  height: 8rpx;
}
.heat-axis {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #bbb;
  margin-top: 12rpx;
}

/* 空态 */
.empty {
  padding: 160rpx 0 0;
  text-align: center;
}
.empty-emoji {
  font-size: 100rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin: 24rpx 0 40rpx;
}
.empty-btn {
  display: inline-block;
  padding: 0 60rpx;
  line-height: 80rpx;
  background: #52C41A;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}
