<view class="page">

  <!-- 未设宝宝档案 -->
  <view class="empty" wx:if="{{state === 'noBaby'}}">
    <view class="empty-emoji">👶</view>
    <view class="empty-text">先创建宝宝档案，才能查看喂养统计</view>
    <view class="empty-btn" bindtap="goBabyEdit">去创建</view>
  </view>

  <block wx:else>
    <!-- 范围切换 -->
    <view class="range-chips">
      <view class="chip {{range === 'month' ? 'active' : ''}}" data-range="month" bindtap="onRange">本月</view>
      <view class="chip {{range === 'all' ? 'active' : ''}}" data-range="all" bindtap="onRange">全部</view>
    </view>

    <!-- 范围内无记录 -->
    <view class="empty" wx:if="{{state === 'empty'}}">
      <view class="empty-emoji">📈</view>
      <view class="empty-text">{{range === 'month' ? '本月还没有喂养记录' : '还没有喂养记录'}}</view>
      <view class="empty-btn" bindtap="goHome">去打卡</view>
    </view>

    <block wx:if="{{state === 'ready'}}">
      <!-- 概览三格 -->
      <view class="card overview">
        <view class="ov-cell">
          <view class="ov-num">{{summary.total}}</view>
          <view class="ov-label">累计记录</view>
        </view>
        <view class="ov-cell">
          <view class="ov-num">{{summary.days}}</view>
          <view class="ov-label">打卡天数</view>
        </view>
        <view class="ov-cell">
          <view class="ov-num">{{summary.recipes}}</view>
          <view class="ov-label">尝试食谱</view>
        </view>
      </view>

      <!-- 反应分布 -->
      <view class="card">
        <view class="section-title">反应分布</view>
        <view class="dist-none-tip" wx:if="{{allNone}}">🎉 全部都是「无反应」，宝宝吃得很顺利！</view>
        <block wx:else>
          <view class="dist-row" wx:for="{{distBars}}" wx:key="key">
            <text class="dist-label" style="color: {{item.color}}">{{item.label}}</text>
            <view class="dist-track">
              <view class="dist-bar" style="width: {{item.width}}%; background: {{item.color}}"></view>
            </view>
            <text class="dist-count">{{item.count}}次</text>
          </view>
        </block>
      </view>

      <!-- 过敏关注 -->
      <view class="card" wx:if="{{allergyRank.length}}">
        <view class="section-title">⚠️ 过敏关注</view>
        <view class="allergy-tip">以下食谱曾引发过敏反应，建议回避并视情况就医排查</view>
        <view class="rank-row" wx:for="{{allergyRank}}" wx:key="id">
          <text class="rank-emoji">{{item.emoji}}</text>
          <text class="rank-title">{{item.title}}</text>
          <text class="rank-count">{{item.count}}次</text>
        </view>
      </view>

      <!-- 近 30 天打卡热度 -->
      <view class="card">
        <view class="section-title">近 30 天打卡热度</view>
        <view class="heat">
          <view class="heat-col" wx:for="{{heatBars}}" wx:key="date">
            <view class="heat-bar {{item.count ? '' : 'heat-zero'}}" style="height: {{item.height}}%"></view>
          </view>
        </view>
        <view class="heat-axis">
          <text>{{heatBars[0].date}}</text>
          <text>今天</text>
        </view>
      </view>

      <!-- 最常做 Top5 -->
      <view class="card" wx:if="{{topRecipes.length}}">
        <view class="section-title">最常做 Top5</view>
        <view class="rank-row" wx:for="{{topRecipes}}" wx:key="id">
          <text class="rank-no {{index < 3 ? 'rank-hot' : ''}}">{{index + 1}}</text>
          <text class="rank-emoji">{{item.emoji}}</text>
          <text class="rank-title">{{item.title}}</text>
          <text class="rank-count">{{item.count}}次</text>
        </view>
      </view>
    </block>
  </block>

</view>
