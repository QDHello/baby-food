.page {
  padding-bottom: 40rpx;
}

/* 月龄卡片 */
.hero {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #95DE64, #52C41A);
  color: #fff;
}
.hero-top {
  display: flex;
  align-items: center;
}
.baby-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}
.baby-info {
  flex: 1;
  margin-left: 24rpx;
}
.baby-name {
  font-size: 34rpx;
  font-weight: 700;
}
.baby-stage {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}
.hero-switch {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 32rpx;
}
.hero-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.5;
}
.hero-actions {
  display: flex;
  margin-top: 24rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  background: #fff;
  color: #52C41A;
  border-radius: 40rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
}
.action-btn.ghost {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  margin-right: 0;
}
.empty-hero {
  display: flex;
  align-items: center;
}
.hero-arrow {
  font-size: 44rpx;
  opacity: 0.7;
}

/* 区块 */
.section {
  margin: 8rpx 24rpx;
}
.section-head {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
}
.more {
  font-size: 26rpx;
  color: #999;
}

/* 食谱网格 */
.recipe-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.recipe-card {
  width: 48.5%;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.06);
}
.recipe-emoji {
  font-size: 64rpx;
}
.recipe-emoji.sm {
  font-size: 56rpx;
  width: 88rpx;
  height: 88rpx;
  background: #E4F3D7;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.recipe-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.recipe-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 食谱列表行 */
.recipe-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.recipe-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #F0F6E8;
}
.recipe-row:last-child {
  border-bottom: none;
}
.row-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.row-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.row-desc {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 今日概览 */
.ov-head-left {
  display: flex;
  align-items: baseline;
  /* 补回 section-title 清掉的下边距，保持与下方列表的间距 */
  margin-bottom: 20rpx;
}
/* 标题右侧中括号日期 */
.ov-head-left .section-title {
  margin-bottom: 0;
}
.ov-date {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}
.overview-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.ov-row {
  display: flex;
  /* 反应标签与标题行顶端对齐，不随缩略图垂直居中 */
  align-items: flex-start;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #F0F6E8;
}
.ov-row:last-child {
  border-bottom: none;
}
.ov-main {
  flex: 1;
  overflow: hidden;
}
.ov-title {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.ov-meal {
  font-size: 22rpx;
  color: #52C41A;
  background: #E4F3D7;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.ov-thumbs {
  display: flex;
  margin-top: 12rpx;
}
.ov-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
}
.ov-empty {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}
.ov-empty-text {
  font-size: 26rpx;
  color: #999;
}
.ov-empty-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 0 48rpx;
  line-height: 68rpx;
  background: linear-gradient(135deg, #95DE64, #52C41A);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 推荐辅食 */
.recommend-title-wrap {
  display: flex;
  align-items: baseline;
}
.recommend-hint {
  font-size: 22rpx;
  color: #52C41A;
  margin-left: 16rpx;
}
.shuffle {
  font-size: 26rpx;
  color: #52C41A;
}
/* 推荐列表底部"查看全部"出口 */
.view-all {
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #52C41A;
}
.card-cover {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  background: #E4F3D7;
}
.recipe-meta {
  margin-top: 12rpx;
}
.reaction {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: #F0F6E8;
  color: #999;
}
.reaction.reaction-allergy {
  background: #ffebee;
  color: #e53935;
}
.reaction.reaction-discomfort {
  background: #FFF6E3;
  color: #FFA726;
}
