<view class="page">

  <!-- 宝宝月龄卡片 -->
  <view class="hero" wx:if="{{baby}}">
    <view class="hero-top">
      <view class="baby-avatar">{{baby.emoji || '👶'}}</view>
      <view class="baby-info">
        <view class="baby-name">{{baby.name}} · {{ageText}}</view>
        <view class="baby-stage">{{stage.name}} · {{stage.desc}}</view>
      </view>
      <view class="hero-switch" bindtap="goBaby">切换</view>
    </view>
    <view class="hero-tip">💡 {{stage.tip}}</view>
    <view class="hero-actions">
      <view class="action-btn" bindtap="goAddRecord">➕ 记一笔</view>
      <view class="action-btn ghost" bindtap="goWiki">📖 食物百科</view>
    </view>
  </view>

  <!-- 无宝宝时引导 -->
  <view class="hero empty-hero" wx:else bindtap="goBaby">
    <view class="baby-avatar">👶</view>
    <view class="baby-info">
      <view class="baby-name">添加宝宝档案</view>
      <view class="baby-stage">记录生日，自动推荐适龄辅食</view>
    </view>
    <view class="hero-arrow">›</view>
  </view>

  <!-- 今日概览：最近一天的记录 -->
  <view class="section">
    <view class="flex-between section-head">
      <view class="ov-head-left">
        <text class="section-title">今日概览</text>
        <text class="ov-date" wx:if="{{overview.state === 'ready'}}">「{{overview.dateLabel}}」</text>
      </view>
      <text class="more" wx:if="{{overview.state === 'ready'}}" bindtap="goRecord">查看全部 ›</text>
    </view>

    <!-- 有记录 -->
    <view class="overview-list" wx:if="{{overview.state === 'ready'}}">
      <view class="ov-row" wx:for="{{overview.items}}" wx:key="id">
        <view class="ov-main">
          <view class="ov-title">
            <text class="ov-meal" wx:if="{{item.mealLabel}}">{{item.mealLabel}}</text>
            <text>{{item.recipeTitle}}</text>
          </view>
          <view class="ov-thumbs" wx:if="{{item.images.length}}">
            <image
              class="ov-thumb"
              wx:for="{{item.images}}"
              wx:for-item="img"
              wx:key="*this"
              src="{{img}}"
              mode="aspectFill"
            ></image>
          </view>
        </view>
        <text class="reaction reaction-{{item.reaction}}">{{item.reactionLabel}}</text>
      </view>
    </view>

    <!-- 从未记录 -->
    <view class="ov-empty" wx:elif="{{overview.state === 'empty'}}">
      <view class="ov-empty-text">还没有记录，从宝宝的第一口辅食开始吧</view>
      <view class="ov-empty-btn" bindtap="goAddRecord">立即记录</view>
    </view>

    <!-- 历史有记录但今天还没有 -->
    <view class="ov-empty" wx:elif="{{overview.state === 'noToday'}}">
      <view class="ov-empty-text">今天还没有喂养记录</view>
      <view class="ov-empty-btn" bindtap="goAddRecord">立即记录</view>
    </view>

    <!-- 未添加宝宝 -->
    <view class="ov-empty" wx:elif="{{overview.state === 'noBaby'}}">
      <view class="ov-empty-text">添加宝宝档案后开始记录喂养日常</view>
    </view>
  </view>

  <!-- 推荐辅食 -->
  <view class="section">
    <view class="section-head">
      <view class="recommend-title-wrap">
        <text class="section-title">{{recommendTitle}}</text>
        <text class="recommend-hint" wx:if="{{recommendHint}}" bindtap="goBaby">{{recommendHint}} ›</text>
      </view>
      <text class="shuffle" wx:if="{{canShuffle}}" bindtap="shuffleRecommend">换一换</text>
    </view>
    <view class="recipe-grid" wx:if="{{recommendRecipes.length}}">
      <view class="recipe-card" wx:for="{{recommendRecipes}}" wx:key="id" data-id="{{item.id}}" bindtap="goRecipe">
        <image
          wx:if="{{item.showCover}}"
          class="card-cover"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          data-id="{{item.id}}"
          binderror="onCoverError"
        ></image>
        <view class="recipe-emoji" wx:else>{{item.emoji}}</view>
        <view class="recipe-title">{{item.title}}</view>
        <view class="recipe-meta">
          <text class="tag">{{item.minMonths}}-{{item.maxMonths}}月</text>
        </view>
      </view>
    </view>
    <view class="view-all" wx:if="{{recommendRecipes.length}}" bindtap="goRecipeList">查看全部 ›</view>
    <view class="empty" wx:else>暂无可推荐食谱，可去百科看看</view>
  </view>

</view>
