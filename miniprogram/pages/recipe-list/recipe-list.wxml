<view class="page">

  <!-- 固定头部：搜索 + 阶段筛选（fixed 避开 sticky 滚动后点击失效的问题） -->
  <view class="fixed-header">
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="搜索食谱或食材"
        value="{{keyword}}"
        bindinput="onSearch"
        confirm-type="search"
      />
    </view>

    <scroll-view scroll-x class="stage-scroll" show-scrollbar="{{false}}">
      <view class="stage-chips">
        <view
          class="chip {{activeStage === '' ? 'active' : ''}}"
          data-stage=""
          bindtap="onStage"
        >全部</view>
        <view
          class="chip {{activeStage === item.key ? 'active' : ''}}"
          wx:for="{{stages}}"
          wx:key="key"
          data-stage="{{item.key}}"
          bindtap="onStage"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>
  <view class="header-placeholder"></view>

  <!-- 食谱列表 -->
  <view class="recipe-list">
    <view class="recipe-row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goRecipe">
      <image
        wx:if="{{item.showCover}}"
        class="row-cover"
        src="{{item.cover}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        data-id="{{item.id}}"
        binderror="onCoverError"
      ></image>
      <view class="recipe-emoji" wx:else>{{item.emoji}}</view>
      <view class="row-info">
        <view class="recipe-title">{{item.title}}</view>
        <view class="recipe-desc">{{item.desc}}</view>
        <view class="row-tags">
          <text class="tag">{{item.minMonths}}-{{item.maxMonths}}月</text>
          <text class="tag tag-green" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!-- 列表到底提示 -->
  <view class="list-end" wx:if="{{list.length}}">— 暂无更多数据 —</view>

  <view class="empty" wx:if="{{!list.length}}">没有找到匹配的食谱</view>

</view>
