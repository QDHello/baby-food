.page {
  padding-bottom: 40rpx;
}

/* 固定头部：搜索 + 阶段筛选，白底一体容器 */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #fff;
  padding-bottom: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.08);
}
/* 占位：撑出与固定头部等高的空间（24 + 80 + 8 + 60 + 12） */
.header-placeholder {
  height: 184rpx;
}
.search-bar {
  margin: 24rpx 24rpx 0;
}
.search-input {
  background: #fff;
  border: 2rpx solid #52C41A;
  border-radius: 40rpx;
  height: 80rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.stage-scroll {
  white-space: nowrap;
  padding: 8rpx 0 0;
}
.stage-chips {
  display: inline-flex;
  padding: 0 24rpx;
}
.chip {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: #F0F6E8;
  color: #52C41A;
  border-radius: 32rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.chip.active {
  background: linear-gradient(135deg, #95DE64, #52C41A);
  color: #fff;
  font-weight: 600;
}

.recipe-list {
  margin: 16rpx 24rpx;
}
.recipe-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.06);
}
.recipe-emoji {
  font-size: 64rpx;
  width: 100rpx;
  height: 100rpx;
  background: #E4F3D7;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.row-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background: #E4F3D7;
  flex-shrink: 0;
}
.row-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.recipe-title {
  font-size: 30rpx;
  font-weight: 700;
}
.recipe-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.row-tags {
  margin-top: 10rpx;
}
.row-arrow {
  color: #ccc;
  font-size: 40rpx;
  margin-left: 12rpx;
}
.list-end {
  text-align: center;
  padding: 24rpx 0 40rpx;
  font-size: 24rpx;
  color: #bbb;
}
