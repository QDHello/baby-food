.page {
  padding-bottom: 40rpx;
}

/* 列表卡片：与食谱列表同款视觉 */
.fav-list {
  margin: 16rpx 24rpx;
}
.recipe-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.06);
}
.recipe-emoji {
  font-size: 64rpx;
  width: 100rpx;
  height: 100rpx;
  background: #E4F3D7;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.row-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background: #E4F3D7;
  flex-shrink: 0;
}
.row-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.recipe-title {
  font-size: 30rpx;
  font-weight: 700;
}
.recipe-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.row-tags {
  margin-top: 10rpx;
}

/* 右侧取消收藏红心：热区放大，catchtap 防止触发卡片跳转 */
.fav-heart {
  width: 72rpx;
  height: 72rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #e53935;
  flex-shrink: 0;
}

.list-end {
  text-align: center;
  padding: 24rpx 0 40rpx;
  font-size: 24rpx;
  color: #bbb;
}

/* 空态 */
.empty {
  padding: 160rpx 0 0;
  text-align: center;
}
.empty-emoji {
  font-size: 100rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin: 24rpx 0 40rpx;
}
.empty-btn {
  display: inline-block;
  padding: 0 60rpx;
  line-height: 80rpx;
  background: #52C41A;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}
