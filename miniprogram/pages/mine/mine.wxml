<view class="page">

  <!-- 用户信息 -->
  <view class="user-card" bindtap="{{userInfo ? '' : 'goLogin'}}">
    <view class="avatar">{{userInfo && userInfo.avatarUrl ? '' : '👨‍👩‍👧'}}</view>
    <view class="user-info">
      <view class="user-name">{{userInfo ? userInfo.nickName : '点击登录'}}</view>
      <view class="user-sub">{{userInfo ? '已登录' : '登录后同步数据'}}</view>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu">
    <view class="menu-item" bindtap="goBaby">
      <text class="menu-icon">👶</text>
      <text class="menu-label">宝宝档案</text>
      <text class="menu-count" wx:if="{{babyCount}}">{{babyCount}}个</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item {{hasBaby ? '' : 'menu-disabled'}}" bindtap="goFavorites">
      <text class="menu-icon">⭐</text>
      <text class="menu-label">我的收藏</text>
      <text class="menu-count" wx:if="{{favCount}}">{{favCount}}个</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMenu">
      <text class="menu-icon">📅</text>
      <text class="menu-label">一周菜单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goStats">
      <text class="menu-icon">📊</text>
      <text class="menu-label">喂养统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="comingSoon">
      <text class="menu-icon">🔔</text>
      <text class="menu-label">喂养提醒</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="comingSoon">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-label">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">📮</text>
      <text class="menu-label">意见反馈</text>
      <text class="menu-arrow">›</text>
      <!-- 隐形 button 仅承载 open-type=feedback 原生能力，视觉由外层 view 渲染 -->
      <button class="feedback-cover" open-type="feedback"></button>
    </view>
  </view>

</view>
