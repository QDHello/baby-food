<view class="page">

  <!-- 用户信息 -->
  <view class="user-card" bindtap="{{userInfo ? '' : 'goLogin'}}">
    <view class="avatar">{{userInfo && userInfo.avatarUrl ? '' : '👨‍👩‍👧'}}</view>
    <view class="user-info">
      <view class="user-name">{{userInfo ? userInfo.nickName : '点击登录'}}</view>
      <view class="user-sub">{{userInfo ? '已登录' : '登录后同步数据'}}</view>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu">
    <view class="menu-item" bindtap="goBaby">
      <text class="menu-icon">👶</text>
      <text class="menu-label">宝宝档案</text>
      <text class="menu-count" wx:if="{{babyCount}}">{{babyCount}}个</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="comingSoon">
      <text class="menu-icon">⭐</text>
      <text class="menu-label">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="comingSoon">
      <text class="menu-icon">🔔</text>
      <text class="menu-label">喂养提醒</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="comingSoon">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-label">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

</view>
