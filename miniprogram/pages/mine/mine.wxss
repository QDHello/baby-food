.user-card {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #95DE64, #52C41A);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  color: #fff;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.user-info {
  margin-left: 24rpx;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
}
.user-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.menu {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F0F6E8;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.menu-label {
  flex: 1;
  font-size: 30rpx;
}
.menu-count {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}
.menu-arrow {
  color: #ccc;
  font-size: 36rpx;
}
