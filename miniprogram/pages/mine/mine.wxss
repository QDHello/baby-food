.user-card {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #95DE64, #52C41A);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  color: #fff;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.user-info {
  margin-left: 24rpx;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
}
.user-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.menu {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F0F6E8;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.menu-label {
  flex: 1;
  font-size: 30rpx;
}
.menu-count {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}
/* 未设宝宝档案时收藏入口置灰 */
.menu-item.menu-disabled .menu-icon,
.menu-item.menu-disabled .menu-label,
.menu-item.menu-disabled .menu-arrow {
  opacity: 0.4;
}
.menu-arrow {
  color: #ccc;
  font-size: 36rpx;
}
/* 意见反馈：button 本体做菜单行。
   重置配方对齐详情页 share-btn（.bottom-bar .share-btn，真机已验证能完美重置）：
   关键点是 min-height:0（基础库给 button:not([size=mini]) 设了固定行高体系）+ 双类选择器压默认值。
   这里用 .menu .feedback-btn 同理。display:flex + align-items 做行内布局，padding 对齐菜单项 */
.menu .feedback-btn {
  display: flex;
  align-items: center;
  width: 100%;
  height: auto;
  min-height: 0;
  padding: 32rpx;
  margin: 0;
  border: none;
  border-radius: 0;
  background: #fff;
  color: inherit;
  font-size: 30rpx;
  font-weight: normal;
  line-height: 1.4;
  text-align: left;
  box-sizing: border-box;
  -webkit-appearance: none;
  appearance: none;
  transition: none;
}
/* 按 view 菜单项规则去掉最后一项分隔线（特异性 0,3,0 与上面的重置块同级，顺序在后生效） */
.menu .menu-item.feedback-btn:last-child {
  border-bottom: none;
}
.menu .feedback-btn::after {
  border: none;
  display: none;
}
