<view class="page">

  <!-- 宝宝切换 -->
  <view class="baby-bar" bindtap="goBaby">
    <view wx:if="{{baby}}">
      <text class="baby-emoji">{{baby.emoji || '👶'}}</text>
      <text class="baby-name">{{baby.name}} · {{ageText}}</text>
    </view>
    <view wx:else class="no-baby">添加宝宝后开始记录 ›</view>
    <text class="baby-switch">切换</text>
  </view>

  <!-- 记录列表 -->
  <block wx:if="{{baby && groupedLogs.length}}">
    <view class="date-group" wx:for="{{groupedLogs}}" wx:key="date" wx:for-item="group" wx:for-index="gi">
      <view class="date-title">{{group.date}}</view>
      <view class="swipe-item" wx:for="{{group.items}}" wx:key="id" wx:for-index="ii">
        <view
          class="swipe-content {{draggingId === item.id ? 'no-transition' : ''}}"
          style="transform: translateX({{item.offset || 0}}px);"
          data-gi="{{gi}}"
          data-ii="{{ii}}"
          data-id="{{item.id}}"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtap="goEdit"
        >
          <view class="log-emoji">{{item.emoji || '🍽️'}}</view>
          <view class="log-info">
            <view class="log-title-row">
              <view class="log-title">{{item.mealLabel ? item.mealLabel + ' · ' : ''}}{{item.recipeTitle}}</view>
              <text class="reaction reaction-{{item.reaction}}" wx:if="{{item.reaction && item.reaction !== 'none'}}">{{item.reactionLabel}}</text>
            </view>
            <view class="log-note" wx:if="{{item.note}}">{{item.note}}</view>
            <view class="log-thumbs" wx:if="{{item.images.length}}">
              <image
                class="log-thumb"
                wx:for="{{item.images}}"
                wx:for-item="img"
                wx:key="*this"
                src="{{img}}"
                mode="aspectFill"
                data-urls="{{item.images}}"
                data-current="{{img}}"
                catchtap="onPreviewImage"
              ></image>
            </view>
          </view>
        </view>
        <view class="swipe-del" data-id="{{item.id}}" catchtap="removeLog">删除</view>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!baby}}">请先添加宝宝档案</view>
  <view class="empty" wx:elif="{{!groupedLogs.length}}">还没有喂养记录，点右下角开始打卡</view>

  <!-- 分页状态提示：仅在记录数超过一页（PAGE_SIZE）时显示 -->
  <view class="load-more" wx:if="{{baby && showPaging}}">
    <text wx:if="{{hasMore}}" bindtap="loadMore">上拉或点击加载更多 · 共 {{totalCount}} 条记录</text>
    <text wx:else>已显示全部 {{totalCount}} 条记录</text>
  </view>

  <!-- 悬浮打卡按钮 -->
  <view class="fab" bindtap="goAdd">＋</view>

</view>
