.page {
  padding-bottom: 160rpx;
}

.baby-bar {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.baby-emoji {
  font-size: 44rpx;
  margin-right: 12rpx;
}
.baby-name {
  font-size: 30rpx;
  font-weight: 600;
}
.no-baby {
  color: #999;
  font-size: 28rpx;
}
.baby-switch {
  font-size: 24rpx;
  color: #ff7043;
}

.date-group {
  margin: 0 24rpx 24rpx;
}
.date-title {
  font-size: 26rpx;
  color: #999;
  margin: 16rpx 8rpx;
}
.log-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 138, 101, 0.06);
}
.log-emoji {
  font-size: 48rpx;
  width: 72rpx;
  text-align: center;
  flex-shrink: 0;
}
.log-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}
.log-title {
  font-size: 30rpx;
  font-weight: 600;
}
.log-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.log-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.reaction {
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}
.reaction-none {
  background: #e8f5e9;
  color: #43a047;
}
.reaction-allergy {
  background: #ffebee;
  color: #e53935;
}
.reaction-discomfort {
  background: #fff3e0;
  color: #fb8c00;
}
.log-del {
  font-size: 22rpx;
  color: #bbb;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a65, #ff7043);
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 112, 67, 0.4);
}
